# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# banco de dados local (dados da família ficam só na sua máquina)
/data/*.db
/data/*.db-journal

# fotos das receitas, enviadas pelo app (ficam só na sua máquina)
/data/uploads/

# cache interno do OCR (Tesseract.js) — só acelera execuções futuras,
# pode ser apagado a qualquer momento sem perda de dados
/data/ocr-cache/

# typescript
*.tsbuildinfo
next-env.d.ts

# arquivos locais que não vão para o GitHub
*.zip
/public/teste-localstorage.html
